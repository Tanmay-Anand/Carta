<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait, design D on a phone (mock desktop/mocks/e-phone.html). The top
     bar names the app and holds Compare; the content area shows the survey (or
     why there is none); the bottom bar says what is happening and holds the
     one action, where a thumb reaches. layout-land/ arranges the same views
     for a phone on its side; the ids match, so MainActivity does not know which
     one it has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="10dp">

        <TextView
            style="@style/Carta.Brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/brand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compare"
            style="@style/Carta.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/compare" />
    </LinearLayout>

    <include layout="@layout/content_area" />

    <!-- The bottom bar. The progress line runs along its top edge over the
         hairline, so the bar does not grow when a survey starts. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:indicatorColor="@color/fg"
            app:trackColor="@color/rule"
            app:trackCornerRadius="0dp"
            app:trackThickness="2dp" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <!-- The tag sits under the status, not beside it: at large font
                 sizes a tag alongside took half the width and cut the status
                 off. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status"
                    style="@style/Carta.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="@string/status_idle" />

                <TextView
                    android:id="@+id/tag"
                    style="@style/Carta.Tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/tag_stopped_early"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/survey"
                style="@style/Carta.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/survey" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
