<?xml version="1.0" encoding="utf-8"?>
<!-- The status strip carries the survey's state and nothing else: the stage and
     its count while running, the result when done. Refusals and drift have
     their own places, so nothing here is ever overwritten by another message. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- The tag sits under the status, not beside it: at large font sizes a
         tag alongside took half the width and cut the status off. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/status"
            style="@style/Carta.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/tag"
            style="@style/Carta.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tag_stopped_early"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:indicatorColor="@color/fg"
        app:trackColor="@color/rule"
        app:trackCornerRadius="0dp"
        app:trackThickness="2dp" />
</LinearLayout>
