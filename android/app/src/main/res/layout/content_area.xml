<?xml version="1.0" encoding="utf-8"?>
<!-- Exactly one of these is visible: the survey, the empty state before the
     first survey, or a refusal. A refusal is an answer — the app looked and
     will not survey here — so it gets the whole content area, not a line of
     dim text in a corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Carta.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/empty_title" />

            <TextView
                style="@style/Carta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/empty_body" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/refusal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/refusalTitle"
                style="@style/Carta.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true" />

            <TextView
                android:id="@+id/refusalReason"
                style="@style/Carta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg" />

            <TextView
                android:id="@+id/refusalNext"
                style="@style/Carta.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refusalAction"
                    style="@style/Carta.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refusalBack"
                    style="@style/Carta.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/refusal_back" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
