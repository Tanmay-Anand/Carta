<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3, with Carta's tokens in every colour role. Light and dark
         come from values/colors.xml and values-night/colors.xml; the theme
         itself is one DayNight theme.

         Dynamic colour is never applied (no DynamicColors call anywhere, and
         none may be added). Carta's colours mean state — partly known,
         unidentified, warning, risk — and colours derived from the wallpaper
         would make those meanings depend on the phone. -->
    <style name="Theme.Carta" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fg</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorPrimaryContainer">@color/panel</item>
        <item name="colorOnPrimaryContainer">@color/fg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/bg</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorError">@color/risk</item>
        <item name="colorOnError">@color/bg</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/fg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/fg</item>
        <item name="colorOnSurfaceVariant">@color/dim</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/panel</item>
        <item name="colorSurfaceContainer">@color/panel</item>
        <item name="colorSurfaceContainerHigh">@color/panel</item>
        <item name="colorSurfaceContainerHighest">@color/panel</item>
        <item name="colorOutline">@color/dim</item>
        <item name="colorOutlineVariant">@color/rule</item>
        <item name="colorSurfaceInverse">@color/fg</item>
        <item name="colorOnSurfaceInverse">@color/bg</item>
        <item name="colorPrimaryInverse">@color/accent_inverse</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/dim</item>

        <!-- 4dp corners, not Material 3's pills: the shape of a control is
             part of Carta's quiet voice. -->
        <item name="shapeAppearanceSmallComponent">@style/Carta.Shape.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/Carta.Shape.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Carta.Shape.Small</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/Carta.Shape.Small</item>

        <item name="materialButtonStyle">@style/Carta.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Carta.Button</item>
    </style>

    <style name="Carta.Shape.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Carta.Mono" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Carta.Brand" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- A state attached to a result, such as STOPPED EARLY. Uppercase mono in
         a hairline box, like the web UI's confidence badges. -->
    <style name="Carta.Tag" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textColor">@color/warn</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:background">@drawable/tag_outline</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Carta.Title" parent="">
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Carta.Body" parent="">
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- 48dp tall with no extra inset: Material adds 6dp above and below a
         button for touch padding, which would grow the bar without growing the
         target. -->
    <style name="Carta.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/button_outline_text</item>
        <item name="strokeColor">@color/button_outline_stroke</item>
        <item name="shapeAppearance">@style/Carta.Shape.Small</item>
    </style>

    <style name="Carta.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="shapeAppearance">@style/Carta.Shape.Small</item>
    </style>
</resources>
