<?xml version="1.0" encoding="utf-8"?>
<!-- Design D's tokens, the same values as internal/ui/assets/app.css and the
     desktop app's theme, so the native chrome and the WebView it frames read as
     one surface. docs/DESIGN_SYSTEM_CARTA.md §2.1 is the reference; change a
     value there, here, in values-night and in app.css together. -->
<resources>
    <color name="bg">#FAFAF8</color>
    <color name="panel">#FFFFFF</color>
    <color name="fg">#111111</color>
    <color name="dim">#62625E</color>
    <!-- Decoration only, never text: it fails 4.5:1 against bg. -->
    <color name="faint">#B4B4AE</color>
    <!-- Hairlines. Named rule since the first design. -->
    <color name="rule">#E4E4DF</color>
    <!-- The selected device and risk: one thing at a time. -->
    <color name="risk">#D92D20</color>
    <color name="warn">#B54708</color>
    <color name="icon_background">#FAFAF8</color>
</resources>
