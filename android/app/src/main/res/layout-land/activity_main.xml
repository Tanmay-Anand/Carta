<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: one row of chrome. On a phone on its side the thumbs are at the
     sides, not the bottom, and every row of chrome comes out of a map that is
     already short, so the status and the actions share the top bar. Same ids
     as the portrait layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/Carta.Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:text="@string/brand" />

        <TextView
            android:id="@+id/status"
            style="@style/Carta.Status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/tag"
            style="@style/Carta.Tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/tag_stopped_early"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compare"
            style="@style/Carta.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/compare" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/survey"
            style="@style/Carta.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:text="@string/survey" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rule" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:indicatorColor="@color/fg"
            app:trackColor="@color/rule"
            app:trackCornerRadius="0dp"
            app:trackThickness="2dp" />
    </FrameLayout>

    <include layout="@layout/content_area" />
</LinearLayout>
