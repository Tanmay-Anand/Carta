<?xml version="1.0" encoding="utf-8"?>
<!-- A text button: dim at rest, as a word that acts. Disabled reads as
     disabled: 38% of it, Material's own rule. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="@color/dim" android:state_enabled="false" />
    <item android:color="@color/dim" />
</selector>
