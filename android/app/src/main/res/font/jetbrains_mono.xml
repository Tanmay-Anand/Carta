<?xml version="1.0" encoding="utf-8"?>
<!-- JetBrains Mono, one variable file serving both weights Carta uses.
     Licence: OFL, shipped as assets/fonts/JetBrainsMono-OFL.txt. The web UI
     loads the same face, so native text and the WebView match. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/jetbrains_mono_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400"
        android:fontWeight="400" />
    <font
        android:font="@font/jetbrains_mono_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
