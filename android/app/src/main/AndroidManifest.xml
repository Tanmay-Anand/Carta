<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Probing the local network: TCP connects, multicast queries, DNS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading where the phone is standing: link properties, transports. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- DHCP server address on API < 30, and the multicast lock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wi-Fi drivers drop multicast to save power unless an app holds a
         multicast lock, and mDNS/SSDP replies would be lost with it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Declared now, requested at runtime only once targetSdk is 37: below
         that, Android grants it implicitly to apps holding INTERNET, and Google
         advises against requesting it early. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- No backup: a survey lists every device on a network and where its
         management interface is. It should not leave the phone that made it. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carta"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
