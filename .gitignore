# Survey output: real networks, real device names, real addresses. Never commit
# one by accident — a document pack is exactly the sort of file that should not
# leave the machine that made it.
carta-surveys/
*.db
*.log

# Binaries. Anchored to the repository root with a leading slash: a bare
# "carta" pattern also matches the cmd/carta/ DIRECTORY, which silently kept
# the entire command out of the first commit.
/carta
/carta.exe
/dist/

# Android. The .aar is built from the Go sources by the bindGo Gradle task on
# every build that needs it; a committed copy would drift from them silently.
android/app/libs/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.jks
*.keystore
android/.kotlin/
